        "俊雅体",
        "喜鹊古字典体(字节试用版)"
      ]
    }
  },
  "typography_hierarchy_principles": [
    {
      "id": "contrast_scale",
      "rule": "同屏双行文字必须拉开字号阶差：主标题/核心词字号为常规底字的 1.8~2.8 倍，顶部巨字达 3.5~5.0 倍"
    },
    {
      "id": "safe_y_convergence",
      "rule": "竖屏 1080x1920 主口播字幕 Y 中心锁定在 0.643~0.760 (1235px~1460px)，水平中心死锁 540px，单行最大宽 <=640px"
    },
    {
      "id": "color_restraint",
      "rule": "单画面文字不超过 2 种颜色（白+黄 或 白+红），满屏同色等于无重点"
    },
    {
      "id": "multi_zone_separation",
      "rule": "顶部常驻标语栏(y=0.09~0.16)、中上巨字/引语卡(y=0.20~0.48)、底部主字幕(y=0.68~0.76)三区严格互斥不重叠"
    }
  ],
