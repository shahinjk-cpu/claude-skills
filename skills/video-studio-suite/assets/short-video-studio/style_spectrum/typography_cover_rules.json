    },
    "warm_amber_gold": {
      "hex": "#FFBF17",
      "usage": "强商业转化/数据/金句高亮，适合门店/房产/律师/财经（占比 13%）"
    },
    "alert_crimson_red": {
      "hex": "#B71C1C",
      "usage": "避坑警示/疑问追问/核心结论印章色（占比 7%）"
    }
  },
