{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Data Screen Template Catalog",
  "type": "object",
  "required": ["version", "screens"],
  "properties": {
    "version": { "type": ["number", "string"] },
    "upstream": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "license": { "type": "string" },
        "capturedCommit": { "type": "string" },
        "capturedAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "archetypes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "path", "preview", "doc", "archetype", "palette", "charts", "modules", "bestFor"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "path": { "type": "string" },
          "preview": { "type": "string" },
          "doc": { "type": "string" },
          "archetype": { "type": "string", "enum": ["A1", "A2", "A3", "A4", "A5", "A6"] },
          "style": { "type": "string" },
          "layout": { "type": "string" },
          "palette": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" } },
          "adaptation": { "type": "string" },
          "stack": { "type": "array", "items": { "type": "string" } },
          "charts": { "type": "array", "items": { "type": "string" } },
          "modules": { "type": "array", "items": { "type": "string" } },
          "bestFor": { "type": "array", "items": { "type": "string" } },
          "difficulty": { "type": "string", "enum": ["low", "medium", "high"] },
          "watchouts": { "type": "array", "items": { "type": "string" } },
          "scanned": { "type": ["object", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
