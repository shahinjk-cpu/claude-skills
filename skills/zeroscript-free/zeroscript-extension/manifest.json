{
  "manifest_version": 3,
  "name": "ZeroScript Free × Roblox Studio Agent",
  "version": "1.9.1",
  "description": "Turn Claude, ChatGPT, DeepSeek, Gemini, Google AI Studio, Grok, Mistral, Kimi, GLM, Qwen, Arena or Meta AI into a Roblox Studio agent with 17 AAA Pro Skills, 60-Gate Luau Auditor, 19 Starter Modules, 12-Genre Style Guide & Project Memory.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://grok.com/*",
    "https://chat.mistral.ai/*",
    "https://www.kimi.ai/*",
    "https://kimi.ai/*",
    "https://chat.z.ai/*",
    "https://chat.qwen.ai/*",
    "https://arena.ai/*",
    "https://www.arena.ai/*",
    "https://lmarena.ai/*",
    "https://www.lmarena.ai/*",
    "https://beta.lmarena.ai/*",
    "https://chat.lmsys.org/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZeroScript Free",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["core/config.js", "core/parser.js", "providers/deepseek.js", "core/main.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["core/config.js", "core/parser.js", "providers/claude.js", "core/main.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://www.chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["providers/chatgpt-cm.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://www.chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["core/config.js", "core/parser.js", "providers/chatgpt.js", "core/main.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["core/config.js", "core/parser.js", "providers/gemini.js", "core/main.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["core/config.js", "core/parser.js", "providers/aistudio.js", "core/main.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://grok.com/*"],
      "js": ["core/config.js", "core/parser.js", "providers/grok.js", "core/main.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.mistral.ai/*"],
      "js": ["core/config.js", "core/parser.js", "providers/mistral.js", "core/main.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.kimi.ai/*", "https://kimi.ai/*"],
      "js": ["core/config.js", "core/parser.js", "providers/kimi.js", "core/main.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.z.ai/*"],
      "js": ["core/config.js", "core/parser.js", "providers/glm.js", "core/main.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://arena.ai/*", "https://www.arena.ai/*", "https://lmarena.ai/*", "https://www.lmarena.ai/*", "https://beta.lmarena.ai/*", "https://chat.lmsys.org/*"],
      "js": ["core/config.js", "core/parser.js", "providers/arena.js", "core/main.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.meta.ai/*", "https://meta.ai/*"],
      "js": ["core/config.js", "core/parser.js", "providers/meta.js", "core/main.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.qwen.ai/*"],
      "js": ["providers/qwen-net.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://chat.qwen.ai/*"],
      "js": ["core/config.js", "core/parser.js", "providers/qwen.js", "core/main.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
